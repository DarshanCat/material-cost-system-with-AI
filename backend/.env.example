# ==============================================================================
# VSPL Material Management & Costing System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   Copy-Item backend\.env.example backend\.env
#
# DO NOT COMMIT PRODUCTION CREDENTIALS OR REAL PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Application Meta
PROJECT_NAME="VSPL Material Management & Costing System"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & CORS
# In production / factory LAN deployment, restrict ALLOWED_ORIGINS to specific workstation IP/domain
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production_environment"
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration (Local Development)
# NOTE: The application will run health checks and startup without blocking if PostgreSQL
# is temporarily offline, but database operations require a running local PostgreSQL instance.
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_local_postgres_password"
POSTGRES_DB="vspl_material_management"

# Optional explicit DATABASE_URL override (if unset, assembled from POSTGRES_* fields above)
# DATABASE_URL="postgresql+psycopg://postgres:your_local_postgres_password@localhost:5432/vspl_material_management"

# Costing & Business Constants (per VSPL Business Rules)
COSTING_START_DATE="2026-10-12"

# Authentication (Security Hardening Sprint 1)
# AUTH_PROVIDER controls how callers are identified. Identity is NEVER taken from X-User-* headers.
#   none (default, fail-closed): no one can sign in; every protected route returns HTTP 401.
#   dev: LOCAL DEVELOPMENT ONLY. Enables loopback-only /api/v1/auth/dev-login that issues signed
#        tokens for fixed dev accounts. Refused when ENVIRONMENT=production.
# The production provider (JWT / Microsoft Entra ID / session) is pending IT Head approval; see
# docs/security/AUTHENTICATION_INTEGRATION.md.
ENVIRONMENT="development"
AUTH_PROVIDER="dev"
