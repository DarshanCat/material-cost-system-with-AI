# Production settings. NAMES and PLACEHOLDERS only: real values live in Secret Manager, never in this repository.
ENVIRONMENT=production
# Google sign-in through Identity-Aware Proxy. The service refuses to start if the next two are missing.
AUTH_PROVIDER=iap
# Cloud Run audience: /projects/<PROJECT_NUMBER>/locations/<REGION>/services/<SERVICE>
IAP_AUDIENCE=<from Secret Manager: vspl-iap-audience>
# JSON map of company Google e-mail to ONE of: Stores, Foundry, Purchase, Management, Admin. Only listed
# accounts can use the app. Example: {"a.person@company.com": "Stores", "b.person@company.com": {"role": "Management", "department": "Plant Head"}}
IAP_ROLE_MAP=<from Secret Manager: vspl-iap-role-map>
# A long random value, never the repository default.
SECRET_KEY=<from Secret Manager: vspl-secret-key>
# Cloud SQL through the Cloud Run connector, for example:
# postgresql+psycopg://vspl_app:<password>@/vspl_mms?host=/cloudsql/<PROJECT>:<REGION>:<INSTANCE>
DATABASE_URL=<from Secret Manager: vspl-database-url>
# The exact address people open, as a JSON list: ["https://<service-url>"]
ALLOWED_ORIGINS=<from Secret Manager: vspl-allowed-origins>
# Interactive API documentation stays off in production (set true only for a short, deliberate check).
# ENABLE_API_DOCS=false
COSTING_START_DATE=2026-10-12
