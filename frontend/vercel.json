{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/work-instruction(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ranging-encroach-payback.ngrok-free.dev/api/$1"
    },
    {
      "source": "/work-instruction",
      "destination": "/work-instruction.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
